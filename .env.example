# Configuração do Supabase do CapacitaTE
# 1. Copie este arquivo para ".env" (o .env não vai para o Git: está no .gitignore).
# 2. Preencha os blocos abaixo.
# 3. Migrar a nuvem para o Supabase local: dois cliques em "migrar-para-local.bat" (precisa do Docker aberto).
# 4. Apontar o app para o Supabase local: dois cliques em "atualizar-env.bat" e recarregue o app (Ctrl+F5).

# ---------------------------------------------------------------------------
# A. Supabase que o app usa (depois da migração, o LOCAL)
# ---------------------------------------------------------------------------
# Endereço da API (Kong) do Supabase local, ex.: http://localhost:8000 ou https://supabase.cecate.ufg.br
# (para o QR Code funcionar no celular, as páginas públicas precisam de HTTPS)
SUPABASE_URL=

# Chave pública (ANON_KEY do .env do docker do Supabase). Nunca use a service_role key aqui.
SUPABASE_ANON_KEY=

# URL pública das páginas de formulário (QR Code), ex.: https://usuario.github.io/capacitate
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# B. Migração (só usados por scripts/migrar-para-local.js; nunca vão para o navegador)
# ---------------------------------------------------------------------------
# Origem: banco da nuvem. Supabase > Project Settings > Database > Connection string > "Session pooler" (porta 5432).
# ex.: postgresql://postgres.abcdefghijklmnop:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
ORIGEM_DB_URL=

# Destino: banco do Supabase local. Use o usuário supabase_admin com a POSTGRES_PASSWORD do .env do docker
# (precisa ser superusuário para restaurar os usuários do login sem disparar gatilhos).
# ex.: postgresql://supabase_admin:SENHA@localhost:5432/postgres
DESTINO_DB_URL=

# Endereço da função de e-mail de confirmação no local, chamada pelo banco (rede interna do docker).
# ex.: http://kong:8000/functions/v1/enviar-confirmacao
DESTINO_CONFIRMACAO_URL=http://kong:8000/functions/v1/enviar-confirmacao

# Versão do cliente Postgres (imagem docker usada para pg_dump/psql). Igual ou maior que a do banco da nuvem.
PG_IMAGEM=postgres:17
